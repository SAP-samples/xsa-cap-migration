PROCEDURE "grant_role" (
	in in_user nvarchar(80),
    in in_role nvarchar(80),
    out ex_message NVARCHAR(255))
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   AS
   lv_schema nvarchar(80);
BEGIN
   /*************************************
       Write your procedure logic 
   *************************************/
   SELECT CURRENT_SCHEMA into lv_schema FROM DUMMY;
   IF :in_role IS NULL OR :in_user IS NULL
      OR NOT (:in_role LIKE_REGEXPR '^[A-Za-z0-9.:#-]+$')
      OR NOT (:in_user LIKE_REGEXPR '^[A-Za-z0-9.:#-]+$') THEN
     ex_message = 'Invalid identifier' ;
     RETURN;
   END IF;
   exec 'GRANT "' ||
     lv_schema  ||
     '"."' || :in_role || '" to "' || :in_user || '"' ;
   ex_message = 'Granted role' || lv_schema || '.' || :in_role ||  ' to ' || :in_user ;
  -- exec :in_user;
END
